# =====================================================================
# INOVATOUR - GITIGNORE (SEM NODE/NPM)
# =====================================================================

# --- CodeIgniter 4 / PHP Especificidades ---
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
!/writable/cache/index.html
!/writable/debugbar/index.html
!/writable/logs/index.html
!/writable/session/index.html

# Arquivos de Configuração Sensíveis (NUNCA enviar ao Git)
.env
.env.backup
.env.production
.env.development

# Pasta Vendor do Composer (Dependências Back-end)
/vendor/
composer.lock

# --- Uploads e Arquivos Dinâmicos de Teste ---
/public/uploads/*
!/public/uploads/index.html

# --- Ambientes de Desenvolvimento e IDEs ---
# VS Code
.vscode/
*.code-workspace

# PhpStorm / IntelliJ
.idea/

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs e Dumps de Banco ---
*.log
*.sql
*.sqlite